# Copie para o gerenciador de segredos da hospedagem. Não faça commit dos valores reais.
NODE_ENV=production
PORT=8788
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/caderno
DATABASE_POOL_SIZE=10
CORS_ORIGIN=https://app.exemplo.com.br
NEXT_PUBLIC_API_URL=https://api.exemplo.com.br
DEV_AUTH_BYPASS=false

# Use filesystem na primeira implantação ou s3 em armazenamento compatível.
FILE_STORAGE_PROVIDER=filesystem
FILE_STORAGE_DIR=/srv/caderno/files
# Compatibilidade com instalações anteriores; omita em uma instalação nova.
EXAM_STORAGE_DIR=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=caderno
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SSE=AES256
# Prefira identidade da máquina. Defina estas variáveis apenas quando o provedor
# não oferecer credenciais temporárias por função/conta de serviço.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# A saída ConTeXt ainda utiliza volume persistente compartilhado.
RENDER_OUTPUT_DIR=/srv/caderno/renders
TEXMFCACHE=/srv/caderno/tex-cache

# Gere com: openssl rand -hex 32
QR_SIGNING_SECRET=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS

RENDERER=context-lmtx
CONTEXT_BIN=/opt/context/tex/texmf-linux-64/bin/context
RENDER_TIMEOUT_MS=300000
RENDER_POLL_MS=3000
PREVIEW_CONCURRENCY=2
IMPORT_POLL_MS=2000

PDFTOTEXT_BIN=pdftotext
PDFTOPPM_BIN=pdftoppm
TESSERACT_BIN=tesseract
IMAGEMAGICK_BIN=magick
OMR_PYTHON=/srv/caderno/venv-omr/bin/python

# Somente o worker de importação recebe esta chave.
EXAM_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EXAM_MODEL=gpt-5-mini
OPENAI_EXAM_BATCH_SIZE=5
OPENAI_BASE_URL=https://api.openai.com/v1
