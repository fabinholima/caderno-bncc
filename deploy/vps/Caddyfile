# HTTPS automático (Let's Encrypt). Os domínios vêm do .env:
#   SITE_DOMAIN=ufaprova.com.br   API_DOMAIN=api.ufaprova.com.br
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip
	# www → endereço principal
	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent
	reverse_proxy frontend:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	# Envio de PDFs e imagens na importação de provas (até 15 MB por arquivo).
	request_body {
		max_size 64MB
	}
	reverse_proxy api:8788
}
