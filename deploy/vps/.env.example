# Copie para .env (cp .env.example .env) e preencha. NUNCA faça commit do .env.
# Os valores marcados "COPIAR DO RENDER" precisam ser IDÊNTICOS aos do Render.

# --- Domínios ---------------------------------------------------------------
# Para testar antes da troca, use subdomínios temporários, por exemplo:
#   SITE_DOMAIN=novo.ufaprova.com.br   API_DOMAIN=api-novo.ufaprova.com.br
SITE_DOMAIN=ufaprova.com.br
API_DOMAIN=api.ufaprova.com.br
# E-mail para avisos do certificado HTTPS (Let's Encrypt).
ACME_EMAIL=

# --- Banco de dados (novo, só deste servidor) --------------------------------
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Segredos: COPIAR DO RENDER (serviço ufaprova-api → Environment) ---------
# CPF_HASH_SECRET diferente = os CPFs já cadastrados deixam de ser reconhecidos.
CPF_HASH_SECRET=
# QR_SIGNING_SECRET diferente = os cartões-resposta já impressos deixam de valer.
# Se ele não existir no Render, deixe em branco (a API usa o mesmo padrão de lá).
QR_SIGNING_SECRET=

# --- Armazenamento de arquivos: COPIAR DO RENDER ----------------------------
FILE_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=caderno
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_SSE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- E-mails de login (Resend): COPIAR DO RENDER ----------------------------
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# --- Login com Google: COPIAR DO RENDER -------------------------------------
# No Google Cloud Console, acrescente a nova URL de retorno:
#   https://API_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mercado Pago: COPIAR DO RENDER -----------------------------------------
# No painel do Mercado Pago, troque a URL do webhook para:
#   https://API_DOMAIN/api/billing/webhook
MP_BILLING_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=

# --- Importação de provas com IA: COPIAR DO RENDER (ufaprova-imports) -------
EXAM_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EXAM_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
