DATABASE_URL=postgresql://caderno:caderno_dev@localhost:5432/caderno
POSTGRES_PORT=5432
PORT=8788
# Separe por vírgula quando também acessar pela rede local.
CORS_ORIGIN=http://localhost:3000,http://192.168.1.20:3000
NEXT_PUBLIC_API_URL=http://localhost:8788
# Atalho somente para desenvolvimento; é ignorado quando NODE_ENV=production.
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_ROLE=admin
EXAM_STORAGE_DIR=./outputs/exam-storage
FILE_STORAGE_DIR=./outputs/file-storage
# Em produção, use filesystem ou s3. Sem ambos, o desenvolvimento guarda os
# PDFs pequenos no PostgreSQL.
FILE_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=caderno
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SSE=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
IMPORT_POLL_MS=2000
# Necessária somente para a análise assistida; nunca exponha no frontend.
OPENAI_API_KEY=
OPENAI_EXAM_MODEL=gpt-5-mini
OPENAI_EXAM_BATCH_SIZE=5
OPENAI_BASE_URL=https://api.openai.com/v1
# Use local_demo apenas para validar a interface sem chamadas externas.
EXAM_AI_PROVIDER=openai
RENDERER=context-lmtx
CONTEXT_BIN=context
PDFTOTEXT_BIN=pdftotext
PDFTOPPM_BIN=pdftoppm
OMR_PYTHON=.venv-omr/bin/python
TESSERACT_BIN=tesseract
IMAGEMAGICK_BIN=magick
RENDER_TIMEOUT_MS=300000
PREVIEW_CONCURRENCY=2
RENDER_OUTPUT_DIR=outputs/renders
RENDER_POLL_MS=3000
QR_SIGNING_SECRET=troque-por-um-segredo-longo-em-producao

# Mercado Pago: manter desativado até homologação. Somente no backend.
MP_BILLING_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=

# Login Google. Em produção usar HTTPS e callback EXATO cadastrado no Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8788/api/auth/google/callback
AUTH_FRONTEND_URL=http://localhost:3000
# Não habilitar em ambientes acessíveis ao público.
AUTH_DEV_RESET_TOKENS=false
CPF_HASH_SECRET=
